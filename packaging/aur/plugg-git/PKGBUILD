# Maintainer: David Fredman <1152707+davfre@users.noreply.github.com>
#
# Builds the manager and the patched yabridge bridge from main and a pinned
# yabridge commit. The Proton runtime is not packaged: the app downloads the
# pinned UMU-Proton release on first use and checks its hash.
#
# Local test build from a checkout:
#   PLUGG_SOURCE="git+file://$(git rev-parse --show-toplevel)#branch=$(git branch --show-current)" makepkg -si

pkgname=plugg-git
pkgver=0.1.0.dev0
pkgrel=1
pkgdesc='Managed Windows VST3 plug-ins for native Linux DAWs, on a pinned Proton runtime'
arch=(x86_64)
url='https://github.com/oikoaudio/plugg'
license=(GPL-3.0-or-later)
depends=(python python-gobject gtk4 zstd libarchive libxcb dbus bubblewrap xdg-utils)
makedepends=(git meson ninja wine go python-build python-installer python-setuptools python-wheel)
provides=(plugg)
conflicts=(plugg)
# !strip and !debug: the bridge's and the forwarder's build.json record the
# hashes of the binaries as built, and Plugg checks them; stripping or
# splitting debug symbols would change them. !lto: the bridge is built with
# yabridge's own flags only (scripts/build-bridge.sh drops the packager's
# CFLAGS and LDFLAGS), because -march flags above the x86-64 baseline break
# the Windows host (diagnostics/host-stack).
options=(!lto !debug !strip)
_yabridge=b580a9f7fc46509767ca156d4f92872552b9e571
source=("plugg::${PLUGG_SOURCE:-git+$url.git#branch=main}"
        "yabridge::git+https://github.com/robbert-vdh/yabridge.git#commit=$_yabridge")
sha256sums=('SKIP'
            'fa7e723cf380027c9c87133259dd08485446144a0d33fba8bd0cc565ea32099f')

pkgver() {
    cd plugg
    # From the latest v<version> tag, as 0.1.0.r3.gabc1234; before the first
    # tag, from the version plugg/__init__.py declares.
    if git describe --long --tags --match 'v[0-9]*' >/dev/null 2>&1; then
        git describe --long --tags --match 'v[0-9]*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
    else
        printf '%s.r%s.g%s' "$(sed -n 's/^__version__ = "\(.*\)"/\1/p' plugg/__init__.py)" \
            "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
    fi
}

prepare() {
    cd plugg
    rm -rf vendor/yabridge
    mkdir -p vendor
    git clone --quiet --no-checkout "$srcdir/yabridge" vendor/yabridge
    git -C vendor/yabridge checkout --quiet --detach "$_yabridge"
}

build() {
    cd plugg
    # A fresh configure every time: makepkg keeps $srcdir between runs, and the
    # bridge build refuses a directory configured with an earlier environment.
    rm -rf "$srcdir/bridge-build" "$srcdir/bridge"
    PLUGG_BUILD_DIR="$srcdir/bridge-build" PLUGG_BRIDGE_OUTPUT="$srcdir/bridge" \
        PLUGG_BUILD_JOBS="${PLUGG_BUILD_JOBS:-2}" scripts/build-bridge.sh
    python scripts/build-powershell-forwarder.py
    python scripts/build-python-package.py --output "$srcdir/dist"
}

check() {
    cd plugg
    python -m unittest discover -s tests -q
}

package() {
    cd plugg
    python -m installer --destdir="$pkgdir" "$srcdir"/dist/*.whl
    install -d "$pkgdir/usr/lib/plugg"
    cp -a "$srcdir/bridge" "$pkgdir/usr/lib/plugg/bridge"
    cp -a bundle/powershell-forwarder "$pkgdir/usr/lib/plugg/powershell-forwarder"
    install -Dm644 packaging/arch/com.oikoaudio.Plugg.desktop \
        "$pkgdir/usr/share/applications/com.oikoaudio.Plugg.desktop"
    install -Dm644 "$srcdir/bridge/COPYING.yabridge" "$pkgdir/usr/share/licenses/$pkgname/COPYING.yabridge"
    install -Dm644 docs/third-party.md "$pkgdir/usr/share/doc/$pkgname/third-party.md"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
